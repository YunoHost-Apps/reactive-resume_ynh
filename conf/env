# Reactive Resume configuration, generated by YunoHost.
# Values are regenerated from the app settings on every upgrade: use the
# config panel instead of editing this file, and put any additional variable
# in __DATA_DIR__/custom.env (it takes precedence over this file).
# Reference: https://docs.rxresu.me/self-hosting/environment-variables

# --- Application ---
NODE_ENV="production"
PORT="__PORT__"
APP_URL="https://__DOMAIN__"
# NGINX runs on the same host and appends the real client address
TRUSTED_PROXIES="127.0.0.1,::1"

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://__DB_USER__:__DB_PWD__@127.0.0.1:5432/__DB_NAME__"
STRICT_SCHEMA_CHECK="false"

# --- Secrets ---
AUTH_SECRET="__AUTH_SECRET__"
ENCRYPTION_SECRET="__ENCRYPTION_SECRET__"

# --- Storage: uploads are kept in the YunoHost data directory ---
STORAGE_BACKEND="local"
LOCAL_STORAGE_PATH="__DATA_DIR__/uploads"

# --- Email, sent through YunoHost's mail server ---
SMTP_HOST="__DOMAIN__"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="__APP__"
SMTP_PASS="__MAIL_PWD__"
SMTP_FROM="Reactive Resume <__APP__@__DOMAIN__>"

# --- Feature flags (managed by the config panel) ---
FLAG_DISABLE_SIGNUPS="__DISABLE_SIGNUPS__"
FLAG_DISABLE_EMAIL_AUTH="__DISABLE_EMAIL_AUTH__"
FLAG_ENABLE_GUEST_LOGIN="false"
FLAG_DISABLE_IMAGE_PROCESSING="false"
FLAG_DISABLE_API_RATE_LIMIT="false"
FLAG_ALLOW_UNSAFE_OAUTH_REDIRECT_URI="false"
FLAG_ALLOW_UNSAFE_AI_BASE_URL="false"
