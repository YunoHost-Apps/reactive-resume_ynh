#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# CHECK UPGRADE PATH
#=================================================

# Reactive Resume v4 used a completely different database schema (Prisma) which
# cannot be upgraded in place: https://docs.rxresu.me/self-hosting/migration
if ynh_app_upgrading_from_version_before 5.0.0~ynh1 \
    && ynh_psql_db_shell <<< "SELECT to_regclass('public._prisma_migrations');" | grep -q "_prisma_migrations"; then
    ynh_die "This instance still holds Reactive Resume v4 data, which cannot be upgraded in place. Install a new instance of the app next to this one and move your resumes over as explained in https://docs.rxresu.me/self-hosting/migration"
fi

#=================================================
# STOP SYSTEMD SERVICE
#=================================================
ynh_script_progression "Stopping $app's systemd service..."

ynh_systemctl --service="$app" --action="stop"

#=================================================
# ENSURE DOWNWARD COMPATIBILITY
#=================================================
ynh_script_progression "Ensuring downward compatibility..."

# Secrets of the v4 package draft are not used anymore
ynh_app_setting_delete --key=key
ynh_app_setting_delete --key=refresh_key

if [ -z "${auth_secret:-}" ]; then
    auth_secret=$(ynh_string_random --length=64)
    ynh_app_setting_set --key=auth_secret --value="$auth_secret"
fi

if [ -z "${encryption_secret:-}" ]; then
    encryption_secret=$(ynh_string_random --length=64)
    ynh_app_setting_set --key=encryption_secret --value="$encryption_secret"
fi

ynh_app_setting_set_default --key=disable_signups --value="false"
ynh_app_setting_set_default --key=disable_email_auth --value="false"

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

# Everything in $install_dir is either upstream code or build output, user data lives in $data_dir
ynh_setup_source --dest_dir="$install_dir" --full_replace

#=================================================
# UPDATE A CONFIG FILE
#=================================================
ynh_script_progression "Updating $app's configuration files..."

ynh_config_add --template="env" --destination="$install_dir/.env"

#=================================================
# BUILD APP
#=================================================
ynh_script_progression "Building $app... (this will take some time and resources!)"

_build_reactive_resume

#=================================================
# REAPPLY SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_nginx

ynh_config_add_systemd

yunohost service add "$app" --description="Reactive Resume resume builder" --log="/var/log/$app/$app.log"

ynh_config_add_logrotate

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

# Database migrations are applied before the server listens
ynh_systemctl --service="$app" --action="start" --wait_until="Up and running" --log_path="/var/log/$app/$app.log" --timeout=180

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
